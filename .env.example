# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentguard?schema=public"

# AI Gateway API (Gemini API)
GEMINI_API_KEY="your-gemini-api-key-here"

# Razorpay TEST Credentials (Do NOT use production keys)
RAZORPAY_KEY_ID="rzp_test_yourkeyid"
RAZORPAY_KEY_SECRET="yourkeysecrethash"
RAZORPAY_WEBHOOK_SECRET="yourwebhooksecrethash"

# Server Port
PORT=3000
